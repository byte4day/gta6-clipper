# Copy to .env and fill in any you have. All are free tiers. More keys = more fallback.
GROQ_API_KEY=          # https://console.groq.com/keys  (LLM + fast Whisper captions)
OPENROUTER_API_KEY=    # https://openrouter.ai/keys     (":free" models)
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
MISTRAL_API_KEY=       # https://console.mistral.ai

# Social auto-upload (Settings → Socials). Redirect URI = http://127.0.0.1:8787/api/socials/callback/<platform>
YOUTUBE_CLIENT_ID=     # Google Cloud OAuth client (YouTube Data API v3 enabled)
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=     # TikTok developer app with Content Posting API
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=      # Meta app + Instagram Business/Creator on a Facebook Page
INSTAGRAM_APP_SECRET=
